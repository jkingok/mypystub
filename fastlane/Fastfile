# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
update_fastlane

require_relative 'app_config'

# Fetch app_identifier from Appfile
def bundle_id
  CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
end

def ipa_name
  "#{AppConfig::APP_NAME}.ipa"
end

# Constructs the complete path where gym/build_app outputs the .ipa file
def ipa_path
  File.join("build", AppConfig::BRIEFCASE_SLUG, "iOS", "Xcode", ipa_name)
end

# Constructs path: build/<briefcase_slug>/iOS/Xcode/<app_name>.xcodeproj
def xcode_project_path
  File.join("build", AppConfig::BRIEFCASE_SLUG, "iOS", "Xcode", "#{AppConfig::APP_NAME}.xcodeproj")
end

default_platform(:ios)

platform :ios do

  desc "Preps the environment (bootstraps uv if missing, runs uv script & briefcase) then builds"
  private_lane :bootstrap do
    default_platform(:ios)
    
    UI.message("--- Step 1: Checking and bootstrapping uv if necessary ---")
    
    # Define local/fallback path for uv if not globally installed
    local_bin_path = File.expand_path("~/.local/bin")
    uv_executable = system("which uv > /dev/null 2>&1") ? "uv" : "#{local_bin_path}/uv"

    unless File.exist?(uv_executable) || system("which uv > /dev/null 2>&1")
      UI.important("uv not found on PATH. Bootstrapping uv locally...")
      
      # Ensure local bin directory exists
      FileUtils.mkdir_p(local_bin_path)
      
      # Download and run Astral's official standalone installer script
      install_success = system("curl -LsSf https://astral.sh/uv/install.sh | sh")
      
      if install_success
        UI.success("Successfully bootstrapped uv!")
      else
        UI.user_error!("Failed to download and install uv automatically.")
      end
    end

    # Ensure local bin path is temporarily appended to ENV['PATH'] for this execution context
    unless ENV['PATH'].include?(local_bin_path)
      ENV['PATH'] = "#{local_bin_path}:#{ENV['PATH']}"
    end

    UI.message("--- Step 2: Running Python script using uv ---")
    # uv will handle dependency resolution (e.g. via PEP 723 inline metadata) automatically
    sh("uv --directory .. run generate_icons.py")

    UI.message("--- Step 3: Running BeeWare Briefcase ---")
    # Triggers your BeeWare packaging/build step (e.g. generating the Xcode project files)
    # Start from a fresh Xcode project: Briefcase only writes Info.plist (permission
    # usage descriptions, info.* keys) on create, and create skips an existing project
    sh("rm", "-rf", File.join("..", "build", AppConfig::BRIEFCASE_SLUG, "iOS"))
    sh("uvx --python 3.15 --directory .. briefcase create ios --no-input")
    sh("uvx --python 3.15 --directory .. briefcase update ios --update-requirements --update-support --update-stub  --update-resources --no-input")
  end

  desc "Decides the calver and build number, then stamps pyproject.toml (#61)"
  private_lane :decide_version do
    # Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: true
    )
    lane_context[:API_KEY] = api_key

    # YYYY.M.D without leading zeros, so Xcode's CFBundleShortVersionString is
    # also exactly the PEP 440 base version in the app's Python metadata
    date_version = Time.now.strftime("%Y.%-m.%-d")

    # Builds on the same day are numbered after the latest one on TestFlight
    latest_build = latest_testflight_build_number(
      version: date_version,
      app_identifier: bundle_id,
      initial_build_number: 0
    )
    build_number = latest_build + 1

    # Python sees <calver>.<build>, e.g. 2026.11.2.3: four numbers, no words
    output = sh("uv --directory .. run scripts/set_version.py #{date_version} #{build_number}")
    UI.success("Python version #{output.lines.last.strip}; Xcode #{date_version} (#{build_number})")

    lane_context[:DATE_VERSION] = date_version
    lane_context[:BUILD_NUMBER] = build_number
  end

  private_lane :update_xcode do
    decide_version

    begin
      # Briefcase copies the stamped version into the app's metadata here
      bootstrap
    ensure
      # Keep the working tree clean: the stamp only needs to reach the build
      sh("git -C .. checkout -- pyproject.toml")
    end

    #unlock_keychain(
    #  path: "login.keychain-db",
    #  password: ENV["LOCAL_MACOS_PASSWORD"]
    #)

    # Set Marketing Version (CFBundleShortVersionString) and build number
    # (CFBundleVersion) from the same values the Python metadata got
    increment_version_number(
      version_number: lane_context[:DATE_VERSION],
      xcodeproj: xcode_project_path
    )
    increment_build_number(
      build_number: lane_context[:BUILD_NUMBER],
      xcodeproj: xcode_project_path
    )

    update_project_team(
      path: xcode_project_path,
      teamid: ENV["APP_STORE_TEAM_ID"]
    )

    update_xcodeproj(
      xcodeproj: xcode_project_path,
      options: {
        'IPHONEOS_DEPLOYMENT_TARGET' => '15.0'
      }
    )

    lane_context[:XCODE_PROJECT] = xcode_project_path
    lane_context[:XCODE_SCHEME] = AppConfig::APP_NAME
  end

  desc "Build Briefcase iOS app (.xcodeproj) and leave signing and deploying to Xcode"
  lane :manual do
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    update_xcode
  end

  private_lane :build_xcode do
    update_xcode

    xcode_project = lane_context[:XCODE_PROJECT]
    xcode_scheme = lane_context[:XCODE_SCHEME]

    # 4. Build and archive using project: instead of workspace:
    build_app(
      #app_store_connect_api_key: api_key,
      project: xcode_project,
      scheme: xcode_scheme,
      export_method: "app-store",
      output_directory: "./build/output",
      output_name: ipa_name,
      clean: true,
      export_options: {
        compileBitcode: false,
        signingStyle: "automatic",
        uploadSymbols: true
      },
      export_team_id: ENV["APP_STORE_TEAM_ID"],
      xcargs: "-allowProvisioningUpdates",
      #xcodebuild_formatter: "xcbeautify"
    )
  end

  desc "Build Briefcase iOS app (.xcodeproj) and deploy to local devices"
  lane :local do
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    build_xcode

    install_on_device(
      #device_id:
      ipa: ipa_path
    )
  end

  desc "Build Briefcase iOS app (.xcodeproj) and upload to TestFlight (pilot)"
  lane :share do
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    #get_certificates
    #get_provisioning_profile

    build_xcode

    api_key = lane_context[:API_KEY]

    changelog_from_git_commits

    # 5. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      #username: ENV["APP_STORE_APPLE_ID"],
      #app_identifier: bundle_id
    )
    #pilot(
    #  api_key: api_key,
    #  ipa: ipa_path,
    #  skip_waiting_for_build_processing: true,
    #  changelog: ENV["RELEASE_NOTES"] || "Automated build submitted via Fastlane & Briefcase."
    #)
  end
end
