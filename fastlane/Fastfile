# Uncomment the line if you want fastlane to automatically update itself
update_fastlane

require_relative 'app_config'

# Fetch app_identifier from Appfile
def bundle_id
  CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
end

def ipa_name
  "#{AppConfig::APP_NAME}.ipa"
end

# Constructs the complete path where gym/build_app outputs the .ipa file
def ipa_path
  File.join("build", AppConfig::BRIEFCASE_SLUG, "iOS", "Xcode", ipa_name)
end

# Constructs path: build/<briefcase_slug>/iOS/Xcode/<app_name>.xcodeproj
def xcode_project_path
  File.join("build", AppConfig::BRIEFCASE_SLUG, "iOS", "Xcode", "#{AppConfig::APP_NAME}.xcodeproj")
end

def current_git_branch
  sh("git -C .. rev-parse --abbrev-ref HEAD", log: false).strip
end

# Copies main, and the release tags on main, to the public repository. Release
# tags (YYYY.M.D.N) are added by the share lanes; the About page links to the tag
# of the running build. Tags on commits that aren't on main are never copied, so
# unmerged work stays private. Run it after merging, from a clone with push
# access to the public repository:
#
#     bundle exec fastlane mirror
def mirror_to_public
  public_url = ENV["PUBLIC_REPO_URL"] || "git@github.com:jkingok/mypystub.git"
  sh("git -C .. remote add public #{public_url}", error_callback: lambda { |_| })
  sh("git -C .. fetch --tags --force --quiet origin")

  # Push the remote-tracking main, not whatever is checked out
  sh("git -C .. push public refs/remotes/origin/main:refs/heads/main --force")

  # Tags never move, so this isn't forced; identical tags are left alone
  tags = sh("git -C .. tag --merged origin/main --list '[0-9][0-9][0-9][0-9].*.*.*'", log: false)
    .lines.map(&:strip)
    .select { |tag| tag.match?(/\A\d{4}\.[1-9]\d?\.[1-9]\d?\.[1-9]\d*\z/) }
  if tags.empty?
    UI.message("No release tags on main to mirror")
  else
    sh("git -C .. push public #{tags.map { |tag| "refs/tags/#{tag}" }.join(' ')}")
  end
end

# The public repository holds the tags and the GitHub Releases the app links to
PUBLIC_REPOSITORY = ENV["PUBLIC_REPOSITORY"] || "jkingok/mypystub"

# Creates (or updates) the GitHub Release for a build on the public repository.
# Its title is the version and its body is that build's What's New text, the
# same Markdown the app shows (scripts/collect_changes.py --release-notes). The
# tag has to be there already: mirror_to_public pushes it.
#
# Needs GITHUB_RELEASE_TOKEN, a token allowed to write Releases on the public
# repository. It comes from the environment, never from this repository. Without
# it the Release is skipped with a warning, since the uploads have already
# happened; run `bundle exec fastlane release version:<version>` later.
def publish_release(version)
  token = ENV["GITHUB_RELEASE_TOKEN"].to_s
  if token.empty?
    UI.important(
      "GITHUB_RELEASE_TOKEN isn't set, so no GitHub Release was made for #{version}. " \
      "Set it and run: bundle exec fastlane release version:#{version}"
    )
    return
  end
  notes = sh("uv --directory .. run scripts/collect_changes.py --release-notes #{version}", log: false).strip
  set_github_release(
    repository_name: PUBLIC_REPOSITORY,
    api_token: token,
    tag_name: version,
    name: version,
    description: notes,
    is_draft: false,
    is_prerelease: false
  )
end

# This release's "What's New" text for the store or tester notes. Falls back to a
# one-line note when the release has no user-facing changes.
def release_notes(python_version)
  notes = sh("uv --directory .. run scripts/collect_changes.py --notes #{python_version}", log: false).strip
  notes.empty? ? "Build #{python_version}. No user-facing changes." : notes
end

# Android signing and distribution settings come from the environment, never from
# this repository. Checked before anything is built or uploaded.
ANDROID_ENV = %w[
  FIREBASE_APP_ID
  FIREBASE_SERVICE_CREDENTIALS_FILE
  ANDROID_KEYSTORE
  ANDROID_KEY_ALIAS
  ANDROID_KEYSTORE_PASSWORD
  ANDROID_KEY_PASSWORD
].freeze

def check_android_env
  missing = ANDROID_ENV.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Set these before an Android release: #{missing.join(', ')}") unless missing.empty?
end

# A local install signs with the release key too, so it installs over a Firebase
# build without uninstalling it; it doesn't need the Firebase settings.
def check_android_signing_env
  missing = ANDROID_ENV.grep(/\AANDROID_/).select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Set these before a signed Android build: #{missing.join(', ')}") unless missing.empty?
end

# The installed app's ID: Briefcase's bundle plus the app name (pyproject.toml)
ANDROID_PACKAGE = "au.id.jking.#{AppConfig::BRIEFCASE_SLUG}"
ANDROID_ACTIVITY = "org.beeware.android.MainActivity"

def adb_path
  sdk = ENV["ANDROID_HOME"] || File.expand_path("~/Library/Android/sdk")
  path = File.join(sdk, "platform-tools", "adb")
  UI.user_error!("adb not found at #{path}; set ANDROID_HOME") unless File.exist?(path)
  path
end

# Briefcase 0.4.x doesn't sign Android packages, so the APK is signed here, with
# the newest build-tools' apksigner in the Android SDK.
def apksigner_path
  sdk = ENV["ANDROID_HOME"] || File.expand_path("~/Library/Android/sdk")
  found = Dir.glob(File.join(sdk, "build-tools", "*", "apksigner"))
  UI.user_error!("apksigner not found under #{sdk}/build-tools; set ANDROID_HOME") if found.empty?
  found.max_by { |path| Gem::Version.new(File.basename(File.dirname(path))) }
end

# Pushes main before anything is uploaded, so a rejected push stops the release
# early. Releases only come from main: on any other branch this stops before
# anything is uploaded, since the tag and the public mirror only cover main.
private_lane :push_main do
  branch = current_git_branch
  UI.user_error!("Release from main, not #{branch}: the tag and the public mirror only cover main") unless branch == "main"
  sh("git -C .. push origin main")
end

# Build numbers already used on `date_version` (YYYY.M.D), from the release tags
# (YYYY.M.D.N, added by the release lanes) that origin has. Every lane tags what
# it uploads, so these are the numbers that are taken.
def tagged_builds(date_version)
  sh("git -C .. fetch --tags --quiet origin", error_callback: lambda { |_|
    UI.important("Couldn't fetch tags; numbering from what is here and the GitHub Releases")
  })
  sh("git -C .. tag --list '#{date_version}.*'", log: false)
    .lines.map { |tag| tag.strip[/\A#{Regexp.escape(date_version)}\.(\d+)\z/, 1] }.compact.map(&:to_i)
end

# The same, from the GitHub Releases of the public repository (anonymous, so only
# public releases). A second source for when tags weren't fetched; best effort.
def released_builds(date_version)
  require "json"
  require "net/http"
  uri = URI("https://api.github.com/repos/#{PUBLIC_REPOSITORY}/releases?per_page=100")
  response = Net::HTTP.get_response(uri)
  unless response.is_a?(Net::HTTPSuccess)
    UI.important("GitHub Releases answered #{response.code}; numbering from tags alone")
    return []
  end
  JSON.parse(response.body).map { |release| release["tag_name"].to_s[/\A#{Regexp.escape(date_version)}\.(\d+)\z/, 1] }.compact.map(&:to_i)
rescue StandardError => error
  UI.important("Couldn't read the GitHub Releases (#{error.message}); numbering from tags alone")
  []
end

# Decides the calver and build number, then stamps pyproject.toml (#61). Memoised
# per run, so every lane in one run shares the same number.
#
# The number comes from GitHub, not App Store Connect: the next build is one more
# than the highest build already tagged on origin or released on the public
# repository for today's date. So a build must always be tagged (every release
# lane does it), or its number would be used again.
#
# Builds are numbered per day: 1 to 99. Android's versionCode is built from the
# build number with two digits, so 100 would break it.
private_lane :decide_version do
  next if lane_context[:PYTHON_VERSION]

  # YYYY.M.D without leading zeros, so Xcode's CFBundleShortVersionString is
  # also exactly the PEP 440 base version in the app's Python metadata
  date_version = Time.now.strftime("%Y.%-m.%-d")

  taken = tagged_builds(date_version) + released_builds(date_version)
  build_number = (taken.max || 0) + 1
  UI.user_error!("Build #{build_number} would be past 99 today; Android needs two digits per build") if build_number > 99

  # Python sees <calver>.<build>, e.g. 2026.11.2.3: four numbers, no words
  output = sh("uv --directory .. run scripts/set_version.py #{date_version} #{build_number}")
  python_version = output.lines.last.strip
  UI.success("Python version #{python_version}; #{date_version} (#{build_number})")

  lane_context[:DATE_VERSION] = date_version
  lane_context[:BUILD_NUMBER] = build_number
  lane_context[:PYTHON_VERSION] = python_version
end

# Writes the decided version into pyproject.toml. Each platform calls this before
# it builds, because the build steps restore pyproject.toml to what is committed
# when they finish (the last release's version, or this one's once it is committed).
private_lane :stamp_version do
  sh("uv --directory .. run scripts/set_version.py #{lane_context[:DATE_VERSION]} #{lane_context[:BUILD_NUMBER]}")
end

# Turn the change fragments in changes/ into this release's "What's New"
# section, and commit them with the release's version, so the build (and its
# tag) contains its own notes and main carries the version last released. That
# keeps `briefcase run` on a device from building an app older than the one
# installed (Android refuses a lower versionCode). uv.lock records the project's
# version too, so it is relocked, or `uv sync --locked` would fail in CI.
private_lane :collect_changes do
  python_version = lane_context[:PYTHON_VERSION]
  sh("uv --directory .. run scripts/collect_changes.py #{python_version}")
  stamp_version # decide_version stamped it, but make sure it is what is committed
  sh("uv --directory .. lock --quiet")
  paths = ["changes", "src/mypystub/resources/templates/changes.md", "pyproject.toml", "uv.lock"]
  # git add fails on a path that doesn't exist, and the archive appears only
  # once something is old enough to go in it
  paths << "changes-archive.md" if File.exist?("../changes-archive.md")
  sh("git -C .. add -A #{paths.join(' ')}")
  if system("git -C .. diff --cached --quiet")
    UI.message("Nothing to record for #{python_version}")
  else
    sh("git -C .. commit -m 'Release #{python_version}: version and notes'")
    sh("git -C .. push origin HEAD", error_callback: lambda { |_|
      UI.important("Couldn't push the release notes commit; push it before the next build")
    })
  end
end

private_lane :tag_release do
  tag = lane_context[:PYTHON_VERSION]
  add_git_tag(tag: tag, message: "Release #{tag}")
  push_git_tags(tag: tag)
  sh("git -C .. fetch --quiet origin main")
  unless system("git -C .. merge-base --is-ancestor HEAD origin/main")
    UI.important(
      "#{tag} tags a commit that isn't on main. The public repository only " \
      "gets tags on main, so the About page's Source link won't work until " \
      "this commit is merged into main as is (not squashed). Release from main " \
      "to avoid this."
    )
  end
end

# The steps after the uploads, shared by every release lane: push main, tag the
# commit, mirror main and its tags to the public repository, and create the GitHub
# Release that the About page links to.
private_lane :finish_release do
  python_version = lane_context[:PYTHON_VERSION]
  push_main
  tag_release
  mirror_to_public
  publish_release(python_version)
end

# ---- iOS building blocks (shared by the ios lanes and both) ----

private_lane :ios_bootstrap do
  UI.message("--- Step 1: Checking and bootstrapping uv if necessary ---")

  # Define local/fallback path for uv if not globally installed
  local_bin_path = File.expand_path("~/.local/bin")
  uv_executable = system("which uv > /dev/null 2>&1") ? "uv" : "#{local_bin_path}/uv"

  unless File.exist?(uv_executable) || system("which uv > /dev/null 2>&1")
    UI.important("uv not found on PATH. Bootstrapping uv locally...")

    # Ensure local bin directory exists
    FileUtils.mkdir_p(local_bin_path)

    # Download and run Astral's official standalone installer script
    install_success = system("curl -LsSf https://astral.sh/uv/install.sh | sh")

    if install_success
      UI.success("Successfully bootstrapped uv!")
    else
      UI.user_error!("Failed to download and install uv automatically.")
    end
  end

  # Ensure local bin path is temporarily appended to ENV['PATH'] for this execution context
  unless ENV['PATH'].include?(local_bin_path)
    ENV['PATH'] = "#{local_bin_path}:#{ENV['PATH']}"
  end

  UI.message("--- Step 2: Running Python script using uv ---")
  # uv will handle dependency resolution (e.g. via PEP 723 inline metadata) automatically
  sh("uv --directory .. run generate_icons.py")
  sh("uv --directory .. run scripts/build_info.py") # branch and commit for About

  UI.message("--- Step 3: Running BeeWare Briefcase ---")
  # Triggers your BeeWare packaging/build step (e.g. generating the Xcode project files)
  # Start from a fresh Xcode project: Briefcase only writes Info.plist (permission
  # usage descriptions, info.* keys) on create, and create skips an existing project
  sh("rm", "-rf", File.join("..", "build", AppConfig::BRIEFCASE_SLUG, "iOS"))
  sh("uvx --python 3.15 --directory .. briefcase create ios --no-input")
  sh("uvx --python 3.15 --directory .. briefcase update ios --update-requirements --update-support --update-stub  --update-resources --no-input")
end

private_lane :update_xcode do
  decide_version

  begin
    # Briefcase copies the stamped version into the app's metadata here
    stamp_version
    ios_bootstrap
  ensure
    # Keep the working tree clean: the stamp only needs to reach the build
    sh("git -C .. checkout -- pyproject.toml")
  end

  #unlock_keychain(
  #  path: "login.keychain-db",
  #  password: ENV["LOCAL_MACOS_PASSWORD"]
  #)

  # Set Marketing Version (CFBundleShortVersionString) and build number
  # (CFBundleVersion) from the same values the Python metadata got
  increment_version_number(
    version_number: lane_context[:DATE_VERSION],
    xcodeproj: xcode_project_path
  )
  increment_build_number(
    build_number: lane_context[:BUILD_NUMBER],
    xcodeproj: xcode_project_path
  )

  update_project_team(
    path: xcode_project_path,
    teamid: ENV["APP_STORE_TEAM_ID"]
  )

  update_xcodeproj(
    xcodeproj: xcode_project_path,
    options: {
      'IPHONEOS_DEPLOYMENT_TARGET' => '15.0'
    }
  )

  lane_context[:XCODE_PROJECT] = xcode_project_path
  lane_context[:XCODE_SCHEME] = AppConfig::APP_NAME
end

private_lane :build_xcode do
  update_xcode

  xcode_project = lane_context[:XCODE_PROJECT]
  xcode_scheme = lane_context[:XCODE_SCHEME]

  # 4. Build and archive using project: instead of workspace:
  build_app(
    #app_store_connect_api_key: api_key,
    project: xcode_project,
    scheme: xcode_scheme,
    export_method: "app-store",
    output_directory: "./build/output",
    output_name: ipa_name,
    clean: true,
    export_options: {
      compileBitcode: false,
      signingStyle: "automatic",
      uploadSymbols: true
    },
    export_team_id: ENV["APP_STORE_TEAM_ID"],
    xcargs: "-allowProvisioningUpdates",
    #xcodebuild_formatter: "xcbeautify"
  )
end

# The TestFlight groups to release to outside the team, from the lane's `external`
# option or TESTFLIGHT_EXTERNAL_GROUPS: comma-separated group names. Empty means
# internal testers only, which Apple doesn't review.
def external_groups(options)
  (options[:external] || ENV["TESTFLIGHT_EXTERNAL_GROUPS"]).to_s.split(",").map(&:strip).reject(&:empty?)
end

# App Store Connect settings come from the environment too. Checked before
# anything is built, so a missing one doesn't surface after the Android build.
IOS_ENV = %w[
  APP_STORE_CONNECT_KEY_ID
  APP_STORE_CONNECT_ISSUER_ID
  APP_STORE_CONNECT_PRIVATE_KEY
  APP_STORE_TEAM_ID
].freeze

def check_ios_env
  missing = IOS_ENV.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Set these before an iOS release: #{missing.join(', ')}") unless missing.empty?
end

# Builds the iOS app (the .ipa), without uploading it.
private_lane :ios_build do
  build_xcode
end

# Uploads the built iOS app to TestFlight with this release's notes. The build
# reaches your internal testers at once. With `external` groups it is also
# submitted for external testing, which needs Apple's Beta App Review (see README).
private_lane :ios_testflight do |options|
  api_key = app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
    is_key_content_base64: true
  )
  lane_context[:API_KEY] = api_key

  # "What to Test" is this build's section of the What's New notes only (not git
  # commits); see scripts/collect_changes.py.
  notes = release_notes(lane_context[:PYTHON_VERSION])
  upload = {
    api_key: api_key,
    changelog: notes[0, 4000]
  }
  groups = external_groups(options || {})
  unless groups.empty?
    # Distributing outside the team has to wait for the build to finish processing
    upload.merge!(distribute_external: true, groups: groups, notify_external_testers: true)
    UI.important("Submitting #{lane_context[:PYTHON_VERSION]} for external testing in: #{groups.join(', ')} (Beta App Review applies)")
  end
  upload_to_testflight(upload)
end

# Builds the iOS app and uploads it to TestFlight.
private_lane :ios_upload do |options|
  ios_build
  ios_testflight(options || {})
end

# ---- Android building blocks (shared by the android lanes and both) ----

private_lane :android_bootstrap do
  sh("uv --directory .. run generate_icons.py")
  sh("uv --directory .. run scripts/build_info.py") # branch and commit for About
  # A fresh Gradle project each time, as with iOS
  sh("rm", "-rf", File.join("..", "build", AppConfig::BRIEFCASE_SLUG, "android"))
  sh("uvx --python 3.15 --directory .. briefcase create android gradle --no-input")
end

# Builds the signed release APK. The build number goes in as `build`, because
# Briefcase only takes the Python version's first three numbers for versionCode.
private_lane :android_build do
  begin
    stamp_version
    android_bootstrap
    sh("uvx --python 3.15 --directory .. briefcase build android --no-input")
    sh("uvx --python 3.15 --directory .. briefcase package android -p apk --no-input -C build=#{lane_context[:BUILD_NUMBER]}")
  ensure
    sh("git -C .. checkout -- pyproject.toml")
  end

  apk = Dir.glob(File.join("..", "dist", "*.apk"))
    .reject { |path| path.end_with?("-signed.apk") }
    .max_by { |path| File.mtime(path) }
  UI.user_error!("Briefcase produced no APK in dist/") unless apk

  signed = apk.sub(/\.apk\z/, "-signed.apk")
  sh(
    apksigner_path, "sign",
    "--ks", ENV["ANDROID_KEYSTORE"],
    "--ks-key-alias", ENV["ANDROID_KEY_ALIAS"],
    "--ks-pass", "env:ANDROID_KEYSTORE_PASSWORD",
    "--key-pass", "env:ANDROID_KEY_PASSWORD",
    "--out", signed,
    apk
  )
  # Absolute, because the Firebase action doesn't share the relative ../dist base
  lane_context[:APK] = File.expand_path(signed)
end

# Uploads the built, signed Android APK to Firebase App Distribution for testers.
private_lane :android_firebase do
  firebase_app_distribution(
    app: ENV["FIREBASE_APP_ID"],
    service_credentials_file: ENV["FIREBASE_SERVICE_CREDENTIALS_FILE"],
    android_artifact_type: "APK",
    android_artifact_path: lane_context[:APK],
    groups: "internal",
    release_notes: release_notes(lane_context[:PYTHON_VERSION])
  )
end

# Builds the Android APK and uploads it to Firebase App Distribution.
private_lane :android_upload do
  android_build
  android_firebase
end

default_platform(:ios)

platform :ios do

  desc "Build Briefcase iOS app (.xcodeproj) and leave signing and deploying to Xcode"
  lane :manual do
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    update_xcode
  end

  desc "Build Briefcase iOS app (.xcodeproj) and deploy to local devices"
  lane :local do
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    build_xcode

    install_on_device(
      #device_id:
      ipa: ipa_path
    )
  end

  desc "Build the iOS app and upload to TestFlight only: no notes commit, tag, mirror or release"
  lane :upload do |options|
    setup_ci if is_ci

    decide_version
    ios_upload(external: options[:external])
    # Tagged even though it isn't released, so the build number isn't used again
    tag_release
  end

  desc "Build Briefcase iOS app (.xcodeproj) and upload to TestFlight, then tag, mirror and release"
  lane :share do |options|
    # 1. Unlock Keychain on CI / Self-Hosted Runner
    setup_ci if is_ci

    #get_certificates
    #get_provisioning_profile

    decide_version
    push_main
    collect_changes
    ios_upload(external: options[:external])
    finish_release
  end
end

platform :android do

  desc "Build the signed APK and install it on a connected device or emulator: no upload, tag or commit. device:<serial> (or ANDROID_SERIAL) picks one of several; see `adb devices -l`"
  lane :local do |options|
    check_android_signing_env

    # Numbered like a release (so its versionCode isn't below one already
    # installed), but not tagged: a later release may use the same number
    decide_version
    android_build

    adb = [adb_path]
    serial = options[:device] || ENV["ANDROID_SERIAL"]
    adb += ["-s", serial] unless serial.to_s.empty?
    # -r replaces the installed app and keeps its data (same signing key)
    sh(*adb, "install", "-r", lane_context[:APK])
    sh(*adb, "shell", "am", "start", "-n", "#{ANDROID_PACKAGE}/#{ANDROID_ACTIVITY}")
  end

  desc "Build the signed Android APK and upload it to Firebase App Distribution only: no notes commit, tag, mirror or release"
  lane :upload do
    check_android_env

    decide_version
    android_upload
    # Tagged even though it isn't released: Android won't install an update whose
    # versionCode isn't higher, so the build number mustn't be used again
    tag_release
  end

  desc "Build the signed Android APK, upload it to Firebase App Distribution, then tag, mirror and release"
  lane :share do
    check_android_env

    decide_version
    push_main
    collect_changes
    android_upload
    finish_release
  end
end

desc "Build iOS and Android, and only then upload to TestFlight and Firebase App Distribution, then push main, tag, mirror and release. Run from main."
lane :both do |options|
  setup_ci if is_ci

  UI.user_error!("Run `both` from main: the tag and the public mirror only cover main") unless current_git_branch == "main"
  check_ios_env
  check_android_env

  decide_version
  push_main
  collect_changes

  # Both builds first: if either fails, neither platform gets a build
  ios_build
  android_build

  # Uploads can still fail one at a time. TestFlight has this build number once
  # its upload succeeds, so tag it even if Firebase then fails, or the next run
  # would number its build the same.
  testflight_done = false
  begin
    ios_testflight(external: options[:external])
    testflight_done = true
    android_firebase
  rescue StandardError
    tag_release if testflight_done
    raise
  end
  finish_release
end

desc "Mirror main and its release tags to the public repository"
lane :mirror do
  mirror_to_public
end

desc "Create the GitHub Release for a version already tagged and mirrored"
lane :release do |options|
  version = options[:version]
  UI.user_error!("Give the version: bundle exec fastlane release version:2026.11.8.1") if version.to_s.empty?
  publish_release(version)
end
